    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: sentences.Array.data[0].sentence
      value: 'Oh my what do we have here? Did you come for the house next door? Haven''t
        seen anyone go there in so long. It''s good you are here. '
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: sentences.Array.data[1].sentence
      value: Baba is a bit old now so I'll pass by later maybe. Cutting all this
        wood isn't ass easy at it once was.
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: sentences.Array.data[2].sentence
