    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: audioSource
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: triggerState
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: sentences.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: sentences.Array.data[0].sentence
      value: "Ah\u2026 thank you, dear. It\u2019s been a long time since I\u2019ve
        done this kind of work."
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: sentences.Array.data[1].sentence
      value: " You know, I used to spend my days at the windmill, grinding flour
        for the village. We didn\u2019t have stores back then\u2026 everything had
        to be done by hand. You get a feel for the rhythm of the land, of the seasons.
        These days, kids just buy flour from the store, but I remember the smell
        of fresh ground wheat, warm and golden. Makes me miss the old days\u2026
        Now I like to make decorations for events. \r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: sentences.Array.data[2].sentence
      value: "Here, take some of this chopped wood for your home. It\u2019ll keep
        your house warm tonight. A little gift for lending me a hand\u2014and a reminder
        that even small efforts can bring warmth in the coldest nights."
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: sentences.Array.data[0].sentenceSound
      value: 
      objectReference: {fileID: 0}
