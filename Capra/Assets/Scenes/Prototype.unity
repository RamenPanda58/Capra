      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: audioSource
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: triggerState
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: sentences.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: sentences.Array.data[0].sentence
      value: "Oh! You\u2019re back! How wonderful to see you again! It\u2019s been
        so long since someone brought a spark of life to this village\u2026 Howw
        are your spring preparations going?\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: sentences.Array.data[1].sentence
      value: "I remember, many years ago, whenever there was a wedding, the whole
        village would come together. Everyone joined in the celebration\u2014family,
        friends, neighbors. There was food, music, dancing\u2026 and of course, the
        Hora! We would dance and laugh for hours, the joy spreading from one end
        of the village to the other. Even the oldest of us would join in, swept up
        by the music and the happiness.\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: sentences.Array.data[2].sentence
      value: "Ah, how I wish I could return to those days, to feel the excitement
        of a wedding and the warmth of the village all around me\u2026 But perhaps
        that\u2019s no longer my place. You, though\u2014you are still young enough.
        Perhaps you can show the village how to celebrate and bring that joy back!\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: sentences.Array.data[3].sentence
      value: "Take these. They\u2019re perfect for spices or tea. Consider it a little
        gift for bringing life back to an old soul like mine."
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: sentences.Array.data[0].sentenceSound
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: sentences.Array.data[1].sentenceSound
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: sentences.Array.data[2].sentenceSound
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: sentences.Array.data[0].dialogueCharacter
      value: 
      objectReference: {fileID: 11400000, guid: f47142af10ab84b4d9be92d73ea189e9, type: 2}
