    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: sentences.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: sentences.Array.data[0].sentence
      value: Who do we have here? Whose child are you?
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: sentences.Array.data[1].sentence
      value: " Oh, it\u2019s so lovely to see a new face in the village! It feels
        like ages since anyone stopped by. Everyone is so bucy with for the spring
        celebrations. My neightbours don't even stop by anymore. "
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: sentences.Array.data[2].sentence
      value: "Please, come in a little closer\u2014here, have some cozonac. Freshly
        baked, just a bit sweet, enough to warm you from the inside.\nWhen making
        this one I was thinking of Tanti Didina. Her milk used to make any dessert
        taste heavenly. I remember the children running to her house just for a taste,
        laughing and calling out their names. But now\u2026 the grass has grown tall
        where her cows used to graze, and her house stands empty. Anyway, how to
        see you again!\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: sentences.Array.data[3].sentence
      value: 'Do come by sometimes. '
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: sentences.Array.data[0].sentenceSound
