    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: audioSource
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: triggerState
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: sentences.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: sentences.Array.data[0].sentence
      value: "You know\u2026 once is by chance, twice is coincidence\u2026 but three
        times? Three times is a pattern. And patterns\u2026 well, patterns mean something.
        You\u2019ve become my friend, dear. My heart feels lighter just seeing you
        here."
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: sentences.Array.data[1].sentence
      value: "This hill\u2026 oh, it used to be alive with children this time of
        year. Sledding, skating on the frozen pond, laughter echoing everywhere.
        Sometimes they\u2019d come to my porch, shivering, forgetting their scarves
        or mittens, and I\u2019d scold them for being so careless\u2026 but I\u2019d
        bring them warm clothes, a little care I could offer. Those days\u2026 they
        remind me of what makes life gentle, even in the cold."
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: sentences.Array.data[2].sentence
      value: "Take this, dear. Let it keep you safe\u2014from dust when cleaning,
        and from the draft, that little devil that always tries to sneak in. Promise
        me\u2026 you\u2019ll carry a bit of this village in your heart, just as I
        will carry the memory of you."
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: sentences.Array.data[3].sentence
      value: 'How are your Spring preparations going? It could be right around the
        corner so it''s good to be ready. I am also sure some of our nieghtbours
        would need some help here and there. Everyone seems so terribly busy. Make
        sure to come to the celebration! It''s going to be right on te very grounds
        I am sitting on! '
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: sentences.Array.data[0].sentenceSound
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: sentences.Array.data[1].sentenceSound
