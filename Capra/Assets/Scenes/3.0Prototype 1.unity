      value: 16.108
      objectReference: {fileID: 0}
    - target: {fileID: 6297276050750010171, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: m_LocalEulerAnglesHint.y
      value: -17.43
      objectReference: {fileID: 0}
    - target: {fileID: 6297276050750010171, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: m_LocalEulerAnglesHint.z
      value: -9.577
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: audioSource
      value: 
      objectReference: {fileID: 1252421918}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: triggerState
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: sentences.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: sentences.Array.data[0].sentence
      value: I have so many memories in this village.
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: sentences.Array.data[1].sentence
      value: It would be a shame to loose all those pages...  I am missing 7.
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: sentences.Array.data[2].sentence
      value: "But the school closed long ago, and the children had to go far away\u2026
        I just couldn\u2019t follow them. It made me miss those lively days terribly.\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: sentences.Array.data[3].sentence
      value: "In my free time, I\u2019ve taken to baking again. Here, take some 
        pie\u2026 well, that\u2019s for you, to enjoy after all your hard work. "
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: sentences.Array.data[4].sentence
      value: "Consider it a small taste of the village\u2019s care. There will be
        more of this at the spring celebration.\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: sentences.Array.data[5].sentence
      value: "In my free time, I\u2019ve taken to embroidery again. Here, take these
        curtains I\u2019ve made\u2014they\u2019re simple, but they bring a little
        warmth to any home. And the pie\u2026 well, that\u2019s for you, to enjoy
        after all your hard work. Consider it a small taste of the village\u2019s
        care.\r\n"
      objectReference: {fileID: 0}
