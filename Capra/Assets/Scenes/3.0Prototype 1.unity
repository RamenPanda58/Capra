  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "'Summer 1958'\n\nToday they're all on our piece of land, neighbours, cousins,
    friends. It's claca day. \nEveryone works together. The men lift planks as if
    they weigh nothing. The rythm of their hammers fills the whole valley. \nThe
    women stir the pot of mamaliga, the butter melts and draws rings in the yellow
    mass. \nIon stands beside me with dust on his cheeks and eyes that shine as if
    the house is already a palace. When the sun sinks, a huse stands there. Our house.
    Made by hands not by money. "
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: e981119c4fb8360468cb3e2f08c2f99f, type: 2}
