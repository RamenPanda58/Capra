  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "'Summer 1950'\n\nI'm supposed to shell corn today. Mama says. But I want
    to play. So I ran. First over the wooden bridge. Then along the stream, my feet
    wet up to my ankles. The sun on by back as I dart into the forest path.  I feel
    freedom in my legs. \nGrandma's house finally appears, small and crooked, smoke
    curling froam the chimney. \nShe opens the door before I even knock. \"Te-ai
    ascuns de munca, nu?\" \nHiding from work again, aren't you? \nI nod. She laughs,
    and let's me in. "
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: e981119c4fb8360468cb3e2f08c2f99f, type: 2}
