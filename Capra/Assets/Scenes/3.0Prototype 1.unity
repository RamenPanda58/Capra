--- !u!114 &1012604804
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1012604802}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "'Winter, 1970s'\n\nThe children are on the frozen river, playing and laughing,
    and I am not with them. They don't stay near the edge, they go towards the middle
    as they always do. I hear later what happens: a crack, water splashing up, one
    foot almost bearking through the ice. \n\nMy hear stops for a moment. I get angry.
    Very angry. I scold them harshly. Maybe too harshly. I know I'm too hard, but
    I can't help it. I love them too much not to be afraid. \nThat nigh I lie in
    bed thinking of them. I hold them in my thoughts longer than usual. I feel every
    moment of fright again, and whisper that I love them. Even if they don't realise
    it, even if I was too fierce. "
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: e981119c4fb8360468cb3e2f08c2f99f, type: 2}
  m_sharedMaterial: {fileID: -5720182614680558781, guid: e981119c4fb8360468cb3e2f08c2f99f, type: 2}
