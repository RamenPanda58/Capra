      value: -0.09149582
      objectReference: {fileID: 0}
    - target: {fileID: 6297276050750010171, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: m_LocalRotation.y
      value: 0.21997198
      objectReference: {fileID: 0}
    - target: {fileID: 6297276050750010171, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: m_LocalRotation.z
      value: 0.020727882
      objectReference: {fileID: 0}
